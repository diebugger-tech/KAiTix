# =============================================================================
# MeinProjekt — Umgebungsvariablen
# =============================================================================
# Kopiere diese Datei zu .env und fülle alle Werte mit echten Daten aus:
#   cp .env.example .env
# ACHTUNG: .env niemals in Git committen!
# =============================================================================

# === DATABASE =================================================================
# MySQL-Verbindung (async SQLAlchemy 2.x)
# Format: mysql+aiomysql://user:password@host:port/database

DATABASE_URL=mysql+aiomysql://meinprojekt_user:CHANGEME@localhost:3306/meinprojekt_db
DATABASE_POOL_SIZE=10
DATABASE_POOL_OVERFLOW=20
DATABASE_POOL_TIMEOUT=30

# === APP_CONFIG ===============================================================
# Allgemeine Anwendungskonfiguration

APP_NAME=MeinProjekt
APP_ENV=development          # development | staging | production
APP_DEBUG=false              # true nur in dev!
APP_HOST=0.0.0.0
APP_PORT=8003
APP_WORKERS=1                # Für dev: 1, prod: nach CPU-Kernen skalieren

# Sicherheit
SECRET_KEY=super-secret-key-change-me-in-production-min-32-chars-long
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS
CORS_ORIGINS=http://localhost:5175,http://localhost:5173,http://localhost:3000

# === API_KEYS =================================================================
# Externe API-Integrationen (nur wenn benötigt)

# Beispiel: Drittanbieter-API
# THIRD_PARTY_API_KEY=your-api-key-here
# THIRD_PARTY_API_URL=https://api.example.com/v1

# === EXTERNAL_SERVICES ========================================================
# Redis, Message Queue, Monitoring, etc.

# Redis (optional, für Caching / Sessions)
# REDIS_URL=redis://localhost:6379/0

# Sentry (optional, für Error Tracking)
# SENTRY_DSN=https://public@sentry.example.com/1

# SMTP / E-Mail (optional, für Notifications)
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=noreply@example.com
# SMTP_PASSWORD=your-smtp-password
# SMTP_TLS=true
